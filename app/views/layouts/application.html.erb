<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Live Log App" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>

    <header class="header">
      <div class="header-logo">
        <%= link_to root_path, class: "header-logo-link" do %>
          <%= image_tag "app_icon.jpg", alt: "LiveLogアイコン", class: "header-logo-icon" %><span>LiveLog</span>
        <% end %>
      </div>

      <div class="header-nav">
        <% if user_signed_in? %>
          <%= link_to users_path, class: "header-btn header-btn-mypage" do %>
            <%= icon "user", class: "header-btn-icon" %>
            <span>マイページ</span>
          <% end %>

          <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "header-btn header-btn-signout" do %>
            <%= icon "log-out", class: "header-btn-icon" %>
            <span>ログアウト</span>
          <% end %>

        <% else %>
          <%= button_to "ゲストログイン", users_guest_sign_in_path, method: :post, class: "header-btn header-btn-guest" %>
          <%= link_to "アカウント作成", new_user_registration_path, class: "header-btn header-btn-signup" %>
          <%= link_to "ログイン", new_user_session_path, class: "header-btn header-btn-signin" %>
        <% end %>
      </div>
        
    </header>

    <%= yield %>

    <div class="flash-message">
      <% if flash[:notice] %>
        <div class="flash-notice">
          <%= flash[:notice] %>
        </div>
      <% end %>
      <% if flash[:alert] %>
        <div class="flash-alert">
          <%= flash[:alert] %>
        </div>
      <% end %>
    </div>
  </body>
</html>
