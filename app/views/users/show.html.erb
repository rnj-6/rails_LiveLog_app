<div class="mypage">

  <div class="mypage-actions">

    
    <%= link_to live_events_path do %>
      <div class="mypage-back-wrapper">
        <%= icon "undo-2", class: "back-icon" %>
        <span>一覧へ戻る<span>
      </div>
    <% end %>
  
    <% unless current_user.guest? %>

      <%= link_to users_edit_path do %>
        <div class="mypage-edit-wrapper">
          <%= icon "square-pen", class: "mypage-edit-icon" %>
          <span>編集</span>
        </div>
      <% end %>
    <% end %>
  </div>

  <div class="page-heading">
    <p>MY PAGE</p>
    <h2>マイページ</h2>
    <p>アカウント情報を確認しよう。</p>
  </div>

  <div class="mypage-card">
    <div class="mypage-profile-image">
      <% if @user.profile_image.attached? %>
        <%= image_tag @user.profile_image.variant(resize_to_fill: [100, 100]) %>
      <% else %>
        <%= image_tag "default_icon.png", width: 100, height: 100 %>
      <% end %>
    </div>

    <div class="mypage-info">
      <div class="mypage-field">
        <p>ニックネーム</p>
        <p><%= @user.name %><p>
      </div>
    
      <div class="mypage-field">
        <p>メールアドレス</p>
        <p><%= @user.email %></p>
       </div>

      <div class="mypage-field">
        <p>パスワード</p>
        <p>*********</p>
      </div>
    </div>
  </div>
</div>
