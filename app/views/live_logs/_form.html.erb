<div class="live-log-form-card">
  <%= form_with model: @live_log, url: live_event_live_log_path(@live_event), local: true do |f| %>

    <div class="live-log-date">
      <%= icon "calendar-days", class: "date-icon" %>
      <span><%= @live_event.event_date.strftime("%Y/%m/%d") %><span>
    </div>

    <p class="live-log-title"><%= @live_event.title %></p>

    <div class="live-log-venue">
      <div class="live-log-venue-wrapper">
        <%= icon "map-pin", class: "map-icon" %>
        <span><%= @live_event.venue_name %></span>
      </div>
      <p><%= @live_event.address %></p>
    </div>

    <div class="input-field">
      <%= f.label :people, "ライブで会った友達", class: "input-field-label" %>
      <%= f.text_field :people, placeholder: "同行者や現地にいた友達など" %>
    </div>

    <div class="input-field">
      <%= f.label :content, "感想", class: "input-field-label" %>
      <%= f.text_area :content %>
    </div>

    <div class="live-log-photo-wrapper">
      <%= f.label :photo, "思い出の一枚", class: "live-log-photo-label" %>
      <div>
        <%= f.file_field :photo, id: "image-upload", hidden: true %>
        <label for="image-upload", class="live-log-photo-btn">画像をアップロード</label>
      </div>
    </div>

    <div class="form-menu">
      <%= link_to "キャンセル", root_path, class: "form-btn-cancel" %>
      <%= f.submit "保存する", class: "form-btn-submit" %>
    </div>

  <% end %>
</div>