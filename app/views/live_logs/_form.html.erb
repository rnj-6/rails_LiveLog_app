<div>
  <%= form_with model: @live_log, url: live_event_live_log_path(@live_event), local: true do |f| %>

    <div>
      <%= f.label :event_date %>
      <%= @live_event.event_date.strftime("%Y/%m/%d") %>
    </div>

    <div>
      <%= f.label :title, "イベント名" %>
      <%= @live_event.title %>
    </div>

    <div>
      <%= f.label :venue_name, "会場" %>
      <%= @live_event.venue_name %>
    </div>

    <div>
      <%= f.label :content, "感想" %>
      <%= f.text_area :content %>
    </div>

    <div>
      <%= f.label :people %>
      <%= f.text_field :people %>
    </div>

    <div>
      <%= f.label :photo, "写真" %>
      <div>
        <%= f.file_field :photo, id: "image-upload", hidden: true %>
        <label for="image-upload">画像をアップロード</label>
      </div>
    </div>

    <div>
      <%= f.submit %>
      <%= link_to "キャンセル", request.referer || root_path %>
    </div>

  <% end %>
</div>