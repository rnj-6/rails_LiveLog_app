<div>
  <div>
    <%= link_to "戻る", request.referer || root_path %>
    <%= link_to "編集", edit_live_event_live_log_path(@live_event) %>
  </div>

  <div>
    <p>開催日</p>
    <%= @live_event.event_date.strftime("%Y/%m/%d") %>
  </div>

  <div>
    <p>イベント名</p>
    <%= @live_event.title %>
  </div>

  <div>
    <p>会場</p>
    <%= @live_event.venue_name %>
    <%= @live_event.address %>
  </div>

  <div>
    <p>目当てのアーティスト</p>
    <%= @live_event.artist_name %>
  </div>

  <div>
    <p>感想</p>
    <%= @live_log.content %>
  </div>

  <div>
    <p>ライブで会った人</p>
    <%= @live_log.people %>
  </div>
</div>