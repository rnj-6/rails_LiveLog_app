<div>
  <%= form_with model: @live_event do |f| %>

  <div>
    <%= f.label :event_date, "開催日" %>
    <%= f.date_field :event_date %>
  </div>

  <div>
    <%= f.label :title, "タイトル" %>
    <%= f.text_field :title, placeholder: "タイトルを入力" %>
  </div>

  <div>
    <%= f.label :artist_name, "目当てのアーティスト" %>
    <%= f.text_field :artist_name, placeholder: "目当てのアーティストを入力" %>
  </div>

  <div data-controller="place-autocomplete" data-place-autocomplete-api-key-value="<%= Rails.application.credentials.dig(:google_maps, :api_key) %>">
    <%= f.label :venue_name, "📍" %>
    
    <%= f.text_field :venue_name,
      id: "place-input",
      placeholder: "会場名を検索...",
      autocomplete: "off",
      data: {
        place_autocomplete_target: "input",
        action: "input->place-autocomplete#search"
      } %>

    <div data-place-autocomplete-target="results"></div>
    <%= f.hidden_field :address,
      id: "place-address",
      data: { place_autocomplete_target: "address" } %>
  </div>

  <div>
    <%= f.submit "保存" %>
    <%= link_to "キャンセル", request.referer || root_path %>
  </div>

  <% end %>
</div>