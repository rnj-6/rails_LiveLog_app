<div class="live-events-page">
  <div class="page-heading">
    <p>MY SCHEDULE</p>
    <h2>参戦予定リスト</h2>
    <p>これから参加する音楽イベントを管理しよう。</p>
  </div>

  <div class="live-events-search">
    <%= form_with url: live_events_path, method: :get, local: true do |f| %>
      <div>
        <div class="search-keyword-wrapper">
          <%= icon "search", class: "search-icon" %>
          <%= f.text_field :keyword, value: @keyword, placeholder: "タイトル名またはアーティスト名を入力", class: "search-keyword" %>
        </div>
        <%# 年単位の絞り込み %>
        <%= f.select :year, [["すべて", ""]] + @years.map { |year| ["#{year}年", year] }, { selected: @year} , { class: "search-filter" } %>
        <%# 月単位の絞り込み %>
        <%= f.select :month, [["すべて", ""]] + (1..12).map { |month| ["#{month}月", month] }, { selected: @month }, { class: "search-filter" } %>
      </div>
      
      <div class="live-events-btn">
        <%= f.submit "検索", class: "live-events-btn-search" %>
        <%= link_to "クリア", live_events_path, class: "live-events-btn-clear" %>
      </div>
    <% end %>
  </div>

  <div class="live-events-table">
    <% @live_events.each do |live_event| %>
    <div class="live-event-card">
      <div>
        <%# チェック状態が変わったら自動送信 %>
        <%= form_with url: toggle_done_live_event_path(live_event), method: :patch do |f| %>
          <%= f.check_box :done, { checked: live_event.done, onchange: "this.form.requestSubmit()", class: "table-checkbox" }, "1", "0" %> 
        <% end %>
      </div>

      <p class="table-date">
        <%= live_event.event_date.strftime("%Y/%m/%d") %>
      </p>

      <div class="table-title-wrapper">
        <p class="table-title"><%= live_event.title %></p>
        <div class="table-artist-wrapper">
          <%= icon "mic-vocal", class: "mic-icon" %>
          <p class="table-artist"><%= live_event.artist_name %></p>
        </div>
      </div>
      
      <div class="table-vanue-wrapper">
        <div class="table-venue">
          <%= icon "map-pin", class: "map-icon" %>
          <p class="table-venue-name"><%= live_event.venue_name %></P>
        </div>
        <p class="table-address"><%= live_event.address %></p>
      </div>

      <div class="table-log-link">
        <% if live_event.live_log.present? %>
          <%# 記録があれば「記録を見る」 %>
          <%= link_to "記録を見る", live_event_live_log_path(live_event), class: "table-log-link-show" %>
        <% elsif live_event.done %>
          <%# 記録がなく、参戦済みなら「感想を書く」 %>
          <%= link_to "感想を書く", new_live_event_live_log_path(live_event), class: "table-log-link-new" %>
        <% end %>
      </div>

      <div class="event-menu">
        <details>
          <summary>…</summary>
          <ul>
            <li>
              <%= icon "square-pen", class: "event-memu-pen" %>
              <%= link_to "イベントを編集", edit_live_event_path(live_event), class: "event-memu-btn-edit" %>
            </li>
            <li>
              <%= icon "trash", class: "event-memu-trash" %>
              <%= link_to "イベントを削除", live_event_path(live_event), class: "event-memu-btn-delete", data: { turbo_method: :delete, turbo_confirm: "「#{live_event.title}」 を削除しますか？" } %>
            </li>
          </ul>
        </details>
      </div>
    </div>
    <% end %>
  </div>
  
  <%= link_to new_live_event_path do %>
    <%= icon "plus", class: "event-btn-plus" %>
  <% end %>
</div>