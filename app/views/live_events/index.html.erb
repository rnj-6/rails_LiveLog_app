<div class="live-events-page">
  <div class="live-events-heading">
    <p>MY SCHEDULE</p>
    <h2>参戦予定リスト</h2>
    <p>これから参加する音楽イベントを管理しよう。</p>
  </div>

  <div class="live-events-search">
    <%= form_with url: live_events_path, method: :get, local: true do |f| %>
      <div>
        <div class="search-keyword-wrapper">
          <%= icon "search", class: "search-icon" %>
          <%= f.text_field :keyword, value: @keyword, placeholder: "タイトル名またはアーティスト名を入力", class: "search-keyword" %>
        </div>
        <%# 年単位の絞り込み %>
        <%= f.select :year, [["すべて", ""]] + @years.map { |year| ["#{year}年", year] }, { selected: @year} , { class: "search-filter" } %>
        <%# 月単位の絞り込み %>
        <%= f.select :month, [["すべて", ""]] + (1..12).map { |month| ["#{month}月", month] }, { selected: @month }, { class: "search-filter" } %>
      </div>
      
      <div class="live-events-btn">
        <%= f.submit "検索", class: "live-events-btn-search" %>
        <%= link_to "クリア", live_events_path, class: "live-events-btn-clear" %>
      </div>
    <% end %>
  </div>

  <table>
    <tr>
      <th></th>
      <th>開催日</th>
      <th>タイトル</th>
      <th>♪</th>
      <th>会場</th>
      <th>ライブの記録</th>
      <th></th>
    </tr>

    <% @live_events.each do |live_event| %>
    <tr>
      <td>
        <%= form_with url: toggle_done_live_event_path(live_event), method: :patch do |f| %>
          <%= f.check_box :done, { checked: live_event.done, onchange: "this.form.requestSubmit()" }, "1", "0" %>  <%# チェック状態が変わったら自動送信 %>
        <% end %>
      </td>
      <td><%= live_event.event_date.strftime("%Y/%m/%d") %></td>
      <td><%= live_event.title %></td>
      <td><%= live_event.artist_name %></td>
      <td>📍<%= live_event.venue_name %></td>
      <td>
        <% if live_event.live_log.present? %>
          <%# 記録があれば「記録を見る」 %>
          <%= link_to "記録を見る", live_event_live_log_path(live_event) %>
        <% elsif live_event.done %>
          <%# 記録がなく、参戦済みなら「感想を書く」 %>
          <%= link_to "感想を書く", new_live_event_live_log_path(live_event) %>
        <% end %>
      </td>

      <td>
        <details>
          <summary>…</summary>
          <ul>
            <li>
              <%= link_to "イベントを編集", edit_live_event_path(live_event) %>
            </li>
            <li>
              <%= link_to "イベントを削除", live_event_path(live_event), data: { turbo_method: :delete, turbo_confirm: "「#{live_event.title}」 を削除しますか？" } %>
            </li>
          </ul>
        </details>
      </td>
    </tr>
    <% end %>
  </table>

  <%= link_to "+", new_live_event_path %>
</div>